{
  "name": "twitter",
  "version": "2.2.1",
  "description": "Follow X (Twitter) accounts into your own Google Sheet: a Tampermonkey userscript collects the posts of a profile while you scroll it in your logged-in browser, the viewer on GitHub Pages writes them to Google Sheets and shows them with filters, search and export. No X API, no server, no secrets in code.",
  "source": "src/index.html",
  "scripts": {
    "clean": "rimraf -rf dist",
    "build-github-pages": "npm run build -- --public-url=/twitter/",
    "serve": "parcel --no-cache --no-source-maps --dist-dir ./dist",
    "prebuild": "npm run clean",
    "build": "parcel build --no-cache --no-source-maps --dist-dir ./dist",
    "postbuild": "npm run userscript",
    "userscript": "bun scripts/build-userscript.ts",
    "start": "pm2 start 'npm run serve' --name app",
    "restart": "pm2 restart app",
    "ps": "pm2 ps",
    "logs": "pm2 logs",
    "stop": "pm2 kill",
    "test": "bun test"
  },
  "keywords": [
    "tailwind",
    "parcel",
    "react",
    "rimraf",
    "pm2",
    "bun",
    "tampermonkey",
    "userscript",
    "google-sheets",
    "x",
    "twitter"
  ],
  "author": "Maksim Kostromin / GitHub: daggerok",
  "license": "MIT",
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/bun": "1.4.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "buffer": "6.0.3",
    "parcel": "2.16.4",
    "pm2": "7.0.4",
    "process": "0.11.10",
    "rimraf": "6.1.3",
    "tailwindcss": "4.3.3"
  },
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
